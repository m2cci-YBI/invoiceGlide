# --- ECR repo (public) ---
ECR_REPO_URI=public.ecr.aws/your-alias/invoices

# --- Database (RDS) ---
# Replace <RDS_ENDPOINT> with the RDSEndpoint output from the stack
DB_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/invoicedb
DB_USER=invoice
DB_PASS=CHANGE_ME_DB_PASSWORD

# --- JWT ---
JWT_SECRET=CHANGE_ME_RANDOM_32_CHARS
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=1209600

# --- App URLs ---
# Public URL of the backend (Caddy on EC2). Use EC2PublicDNS output.
APP_BASE_URL=http://<EC2_PUBLIC_DNS>
# Allow your local frontend to call the remote backend during testing
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Seed User ---
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=ChangeMe123!
SEED_USER_NAME=Admin

# --- Mail Service ---
MAILTRAP_API_TOKEN=<YOUR_MAILTRAP_TOKEN>
ATTACH_PDF=true
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
SMTP_FROM=invoices@example.com

# Internal service URL (inside Docker network)
INVOICE_API_BASE=http://invoice-service:8082/api/invoice/v1
MAILING_BASE_URL=http://mailing-service:8083/api/mail/v1

